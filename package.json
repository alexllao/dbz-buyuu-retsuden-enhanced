{
  "name": "dbz-buyuu-retsuden-enhanced",
  "version": "0.1.0",
  "private": true,
  "description": "Parches, herramientas y revisión gráfica de Buyuu Retsuden para Mega Drive",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "author": "Àlex Llaó alexllao@me.com",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "check": "node tools/verify.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node tools/build.mjs",
    "build:colors": "node tools/build.mjs --variant colors",
    "assemble": "pwsh -NoProfile -File tools/assembly/assemble.ps1",
    "build:auras": "node tools/build-auras.mjs",
    "build:auras:v2": "node tools/build-auras.mjs --version c2-v2",
    "build:auras:v3": "node tools/build-auras.mjs --version c2-v3",
    "build:auras:no-rays": "node tools/build-auras.mjs --version c2-v3-no-rays"
  }
}
